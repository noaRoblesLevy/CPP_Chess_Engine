{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20", "-Wall", "-Wextra", "-O2", "-static",
                "src/*.cpp",
                "-o", "engine.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:/msys64/mingw64/bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build-debug",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20", "-Wall", "-Wextra", "-g", "-O0",
                "src/*.cpp",
                "-o", "engine-debug.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:/msys64/mingw64/bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./engine.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "build",
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
